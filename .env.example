# Copia este fichero a .env para desarrollo local, o usa estas mismas
# claves como variables de entorno del servicio backend en Railway.
# Variables leidas por app/config.py (ver Settings).

# Postgres. En local, docker-compose.yml expone el servicio "db" en
# localhost:5433 con estas credenciales:
#   DATABASE_URL=postgresql+asyncpg://worlddraft:worlddraft@localhost:5433/worlddraft
# En Railway, usa la DATABASE_URL que provisiona el plugin de PostgreSQL
# (Variables > DATABASE_URL, o referenciala con ${{Postgres.DATABASE_URL}}
# desde el servicio backend). Railway la da como postgresql://... o
# postgres://...; app/config.py la reescribe sola al driver asyncpg
# (postgresql+asyncpg://) que necesita SQLAlchemy async, asi que no hace
# falta tocarla a mano.
DATABASE_URL=postgresql+asyncpg://worlddraft:worlddraft@localhost:5433/worlddraft

# Clave para firmar los JWT (login y cookie de sesion). En produccion debe
# ser un valor aleatorio largo y distinto del de desarrollo -- por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Cualquiera con este valor puede falsificar tokens de sesion validos.
SECRET_KEY=change-me-to-a-random-secret-in-production

# "development" (por defecto) o "production". Controla si la cookie de
# sesion se manda con Secure/SameSite=None (necesario en producción,
# porque frontend y backend viven en dominios de Railway distintos) o con
# el comportamiento de desarrollo local (HTTP, mismo origen via el proxy
# de Vite). Ver app/auth/cookies.py.
ENVIRONMENT=development

# Origenes (scheme+host, separados por coma) desde los que el navegador
# puede llamar a esta API con credenciales (cookie de sesion). En
# desarrollo se deja vacio: el proxy de Vite hace que las peticiones sean
# same-origin y CORS no entra en juego. En Railway, la URL publica del
# servicio del frontend, p.ej.:
#   CORS_ORIGINS=https://worlddraft-frontend.up.railway.app
CORS_ORIGINS=

# Usadas solo por docker-compose.yml para levantar Postgres en local (deben
# coincidir con las credenciales embebidas en DATABASE_URL de arriba). No
# aplican a Railway, que provisiona sus propias credenciales.
POSTGRES_USER=worlddraft
POSTGRES_PASSWORD=worlddraft
POSTGRES_DB=worlddraft
